{
  "include": [
    "client/src/**/*",
    "shared/**/*",
    "server/**/*",
    "scripts/**/*",
    /**
     * The build's own configuration.
     *
     * It was not checked at all — so a change to the aliases, the
     * bundler or the migration setup could break the build without
     * anything saying so until the build itself was run.
     */
    "vite.config.ts",
    "vitest.config.ts",
    "drizzle.config.ts"
  ],
  "exclude": ["node_modules", "build", "dist"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "target": "ES2022",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"]
    }
  }
}
